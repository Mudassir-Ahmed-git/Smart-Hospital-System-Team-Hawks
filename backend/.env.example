# Copy to .env
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/smart_hospital
# or for a zero-setup local run:  DATABASE_URL=sqlite:///./smart_hospital.db

# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production-please-use-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=720

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Demo convenience: lets anyone pick any role on the register page (the frontend does this).
# Set to false in production - then only patients can self-register.
ALLOW_OPEN_ROLE_REGISTRATION=true
DEFAULT_STAFF_HOSPITAL_ID=1

# Fallback location used for distances when the client sends no lat/lng (Karachi)
DEFAULT_LATITUDE=24.8607
DEFAULT_LONGITUDE=67.0011
